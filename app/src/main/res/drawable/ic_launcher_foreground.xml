<?xml version="1.0" encoding="utf-8"?>
<!--
  Thrum's mark: the pulse ribbon.

  The same five-bar rhythm the app draws on its own screen, because that is the
  one thing this product has that nothing else does — the score, made visible.
  An icon is not the place to introduce a second idea.

  Drawn as vector rather than exported as PNG at five densities: it is five
  rectangles, it is exact at every size, and there is no raster to go soft in a
  launcher's circle mask.

  Geometry, for anyone who has to touch this later. The adaptive canvas is
  108x108 and the inner 66x66 (21 to 87) is what a launcher is guaranteed to
  show, so the bars live between x=24 and x=84 and between y=24 and y=82 — clear
  of the mask on every shape, including the round one. Bars are 8 wide with a
  5 gap, and bottom-aligned on y=82 so it reads as a rhythm rather than a chart.

  Square corners, deliberately. `design-brief.md` Phase 3: a rounded bar reads as
  a decorative chart, and this is a machine part shown at its real shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Safety yellow, the accent from the sulphur-concrete colour world. -->
    <path android:fillColor="#D8C513" android:pathData="M24,62 h8 v20 h-8 z" />
    <path android:fillColor="#D8C513" android:pathData="M37,38 h8 v44 h-8 z" />
    <path android:fillColor="#D8C513" android:pathData="M50,24 h8 v58 h-8 z" />
    <path android:fillColor="#D8C513" android:pathData="M63,50 h8 v32 h-8 z" />
    <path android:fillColor="#D8C513" android:pathData="M76,68 h8 v14 h-8 z" />
</vector>
