    <string name="app_name">Thrum</string>

    <!-- Blocked: the motor cannot vary strength. Terminal, and honest about it (Sacred
         Rule 2), in kinder words since 2026-10-06. It shows before any permission is
         asked, which is what makes "hasn't changed anything" true. -->
    <string name="blocked_title">This phone can\'t play rhythms</string>
    <string name="blocked_body">Thrum turns music into a beat you can feel. That needs a vibration
        motor that can go softer and stronger, and this phone\'s motor has only one strength, so
        every song would feel like the same plain buzz. It\'s how the phone was built, and no
        setting can change it.</string>
    <string name="blocked_safe">Thrum hasn\'t changed anything on your phone, so it\'s safe to uninstall.</string>
    <string name="blocked_detail">What Thrum checked: vibration motor, %1$s. Strength control, %2$s.</string>

    <!-- Permission -->
    <string name="permission_title">Thrum has to see your call notifications</string>
    <string name="permission_body">It is how the app knows a call has started. Thrum checks one
        thing: is this a call? The rest it ignores. Nothing leaves your phone. There is no
        internet permission in this app and there never will be.</string>
    <string name="permission_action">Turn on notification access</string>

    <!-- Locked: Android 13+ greys out notification access for an app installed
         from a file. Shown once the user has tried the switch and come back
         without access. "Allow restricted settings" is Android's own menu
         item; keep its words exactly. -->
    <string name="locked_title">Did Android say it\'s restricted?</string>
    <string name="locked_body">It does that to apps installed from a file, not the Play Store. To unlock it:</string>
    <string name="locked_step_1">Open App info with the button below.</string>
    <string name="locked_step_2">Tap ⋮ at the top right, then Allow restricted settings.</string>
    <string name="locked_step_3">Come back here and turn access on again.</string>
    <string name="locked_action">Open App info</string>

