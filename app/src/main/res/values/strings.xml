    <string name="tune_intro">Pick how the beats feel. Tap Feel it to try it.</string>
    <string name="tune_preset_crisp">Crisp</string>
    <string name="tune_preset_crisp_help">Short taps with space between them.</string>
    <string name="tune_preset_full">Full</string>
    <string name="tune_preset_full_help">Longer taps with more push.</string>
    <string name="tune_preset_strong">Strong</string>
    <string name="tune_preset_strong_help">The longest taps, closest to your phone\'s own buzz.</string>
