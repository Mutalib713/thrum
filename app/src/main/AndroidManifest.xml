<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The whole point of the app. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Music access (Task 20). Asked only when the user taps "Scan for music",
      never at launch. READ_MEDIA_AUDIO is the Android 13+ form; the storage
      permission covers Android 12, this app's floor (minSdk 31), and stops
      applying above it by maxSdkVersion. Audio only by construction — the
      manifest never asks for anything that would let the app see photos,
      or videos by scan.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Playing a song with Thrum closed or the screen off (PROFILE §4, moved
      into v1 on 2026-10-04). Android keeps a media player alive only as a
      foreground service, and from Android 14 that service has to say it is
      for media playback. The notification it shows is a media notification,
      which needs no notification permission on Android 13+.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      Deliberately absent, and PROFILE.md Sacred Rule 3 keeps it that way:
      no INTERNET permission. Nothing this app touches leaves the phone.
    -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.Thrum">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Sees the incoming-call notification. Chosen over READ_PHONE_STATE and
          over replacing the dialer, both of which are far heavier asks for an
          app that only vibrates. The user grants this in system settings and can
          revoke it there; no manifest permission can grant it.
        -->
        <service
            android:name=".NotifService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          The player's notification and lock-screen controls. Exported because
          the phone's own controls (the notification shade, Bluetooth
          headphones, a car) connect to it from outside the app.
        -->
        <service
            android:name=".PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
