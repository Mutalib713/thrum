<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The whole point of the app. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Deliberately absent, and PROFILE.md Sacred Rule 3 keeps it that way:
      no INTERNET permission. Nothing this app touches leaves the phone.
    -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Thrum">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Sees the incoming-call notification. Chosen over READ_PHONE_STATE and
          over replacing the dialer, both of which are far heavier asks for an
          app that only vibrates. The user grants this in system settings and can
          revoke it there; no manifest permission can grant it.
        -->
        <service
            android:name=".NotifService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
