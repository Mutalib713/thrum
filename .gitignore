*.iml
.gradle/
/local.properties
/.idea/
.DS_Store
# "build/" not "/build" — the leading slash only matches the repo root, which
# left every app/build artifact untracked-but-visible and swept thousands of
# generated files into the first `git add -A`.
build/
/captures
.externalNativeBuild
.cxx
local.properties

# signing — never commit
*.jks
*.keystore
keystore.properties

# build truststore (machine-specific, holds Avast root CA)
build-truststore.jks
build-truststore.p12

# outputs
*.apk
*.aab
*.ap_
*.dex

# scratch
/scratch/
*.log
